{
  "name": "alfred-desk",
  "version": "0.1.0",
  "private": true,
  "description": "Alfred — a personal chief-of-staff desk with real Gmail access",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^32.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.alfred.desk",
    "productName": "Alfred",
    "files": [
      "main.js",
      "preload.js",
      "index.html"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Alfred-Setup-${version}.${ext}"
    }
  }
}
