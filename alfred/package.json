{
  "name": "alfred-desk",
  "version": "0.1.0",
  "private": true,
  "description": "Alfred — a personal chief-of-staff desk with real Gmail access",
  "author": "Alfred",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win"
  },
  "dependencies": {
    "imapflow": "^1.0.171",
    "mailparser": "^3.7.1",
    "nodemailer": "^6.9.15"
  },
  "devDependencies": {
    "electron": "^32.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.alfred.desk",
    "productName": "Alfred",
    "asar": true,
    "asarUnpack": [
      "node_modules/imapflow/**",
      "node_modules/mailparser/**",
      "node_modules/nodemailer/**"
    ],
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "assets/**/*",
      "node_modules/**/*",
      "!**/_*.log",
      "!.env",
      "!.env.*"
    ],
    "win": {
      "target": "dir",
      "icon": "assets/alfred.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Alfred-Setup-${version}.${ext}"
    }
  }
}
